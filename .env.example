# Порт, на котором слушает сервер
PORT=3000

# Папка для базы данных и загруженных картинок (её нужно бэкапить)
DATA_DIR=./data

# Первый администратор: создаётся при запуске, если такого email ещё нет.
# После первого входа смените пароль в профиле и можно удалить эти строки.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=смените-этот-пароль

# Название сайта по умолчанию (потом меняется в админке)
SITE_NAME=MedStep

# 0 — не добавлять демо-вопросы в пустую базу
SEED_DEMO=1

# Включите, когда сайт работает за Nginx/Caddy с HTTPS
TRUST_PROXY=1
COOKIE_SECURE=1
